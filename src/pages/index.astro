---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Portfolio de Iker Vericat">
  <main id="inicio" class="w-full overflow-x-hidden">
    <Header />
    <Hero />

    <!-- Sección Experiencia -->
    <section
      id="experiencia"
      class="mx-auto max-w-7xl px-4 py-12 sm:px-8 sm:py-16 lg:px-16"
    >
      <div class="mb-8 sm:mb-12 text-left">
        <h2 class="pb-2 sm:pb-4 text-base sm:text-lg font-medium tracking-tight text-blue-500">
          EXPERIENCIA
        </h2>
        <p class="text-3xl font-medium tracking-tight text-balance text-white sm:text-4xl lg:text-5xl">
          Experiencia laboral
        </p>
      </div>

      <!-- Experiencia 1 -->
      <div class="flex w-full flex-col items-center gap-8 md:flex-row md:gap-10 lg:gap-16">
        <div class="w-full text-left md:w-1/2">
          <h3 class="pb-4 sm:pb-6 text-base sm:text-lg font-medium tracking-tight text-blue-500">
            SYSTEM ADMINISTRATOR
          </h3>
          <p class="text-base sm:text-lg font-medium text-pretty text-gray-400">
            He adquirido experiencia en el sector de la administración de
            sistemas trabajando como técnico y administrador de sistemas en
            Temple Autoescoles. Allí realicé tareas relacionadas con la gestión
            y solución de incidencias informáticas, instalación y mantenimiento
            de servidores, instalación de sistemas operativos, software y
            hardware, además de configuración y mantenimiento de redes.
          </p>
        </div>
        <div class="w-full md:w-1/2">
          <img
            src="/images/autoescolaTemple.jpg"
            alt="Autoescola Temple"
            class="aspect-video w-full rounded-2xl object-cover object-[66%_center] shadow-lg"
            loading="lazy"
          />
        </div>
      </div>

      <hr class="mx-auto my-12 w-full max-w-5xl border-neutral-800 sm:my-20" />

      <!-- Experiencia 2 -->
      <div class="flex w-full flex-col items-center gap-8 md:flex-row md:gap-10 lg:gap-16">
        <div class="order-2 w-full md:order-1 md:w-1/2">
          <img
            src="/images/web_deb_experience.jpg"
            alt="Experiencia Web Developer"
            class="aspect-video w-full rounded-2xl object-cover object-[66%_center] shadow-lg"
            loading="lazy"
          />
        </div>
        <div class="order-1 w-full text-left md:order-2 md:w-1/2">
          <h3 class="pb-4 sm:pb-6 text-base sm:text-lg font-medium tracking-tight text-blue-500">
            WEB DEVELOPER
          </h3>
          <p class="text-base sm:text-lg font-medium text-pretty text-gray-400">
            He adquirido experiencia laboral en el sector del desarrollo web
            debido a mis prácticas en Empàtica S.L., donde trabajé con el CMS
            WordPress y constructores como Elementor y WPBakery. Realicé
            tareas de interpretación de diseño, guías de estilo, desarrollo de
            aplicaciones web interactivas y gestión de servidores. También
            gestioné entornos (edición, depuración y documentación de código)
            y el despliegue y mantenimiento de las plataformas.
          </p>
        </div>
      </div>
    </section>

    <hr class="mx-auto my-12 w-full max-w-5xl border-neutral-800 sm:my-20" />

    <!-- Sección Sobre Mí -->
    <section
      id="sobre-mi"
      class="mx-auto max-w-7xl px-4 py-12 sm:px-8 sm:py-16 lg:px-16"
    >
      <div class="flex w-full flex-col items-center gap-8 md:flex-row md:gap-10 lg:gap-16">
        <div class="w-full text-left md:w-1/2">
          <h2 class="pb-2 sm:pb-4 text-base sm:text-lg font-medium tracking-tight text-blue-500">
            SOBRE MÍ
          </h2>
          <p class="text-3xl font-medium tracking-tight text-balance text-white sm:text-4xl lg:text-5xl">
            Iker Vericat
          </p>
          <p class="mt-6 sm:mt-10 text-base sm:text-lg font-medium text-pretty text-gray-400">
            Soy desarrollador de software y técnico informático afincado en
            Cataluña. Con formación en Sistemas Microinformáticos (SMX) y
            Desarrollo Web (DAW), disfruto construyendo aplicaciones completas,
            cuidando tanto la lógica interna como la experiencia de usuario
            (UX/UI). Mi stack principal se centra en Laravel, PHP, Vue.js,
            TypeScript y Tailwind CSS, y me mantengo en constante aprendizaje,
            incorporando tecnologías modernas como Astro a mis proyectos más
            recientes.
          </p>
        </div>
        <div class="w-full md:w-1/2">
          <img
            src="/images/foto-sobre-mi.webp"
            alt="Retrato de Iker Vericat"
            class="aspect-[4/5] max-h-[550px] w-full rounded-2xl object-cover object-[66%_center] shadow-lg"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <hr class="mx-auto my-12 w-full max-w-5xl border-neutral-800 sm:my-20" />

    <!-- Sección Proyectos -->
    <section
      id="proyectos"
      class="mx-auto max-w-7xl px-4 py-12 sm:px-8 sm:py-16 lg:px-16"
    >
      <div class="mb-8 sm:mb-12 text-left">
        <h2 class="pb-2 sm:pb-4 text-base sm:text-lg font-medium tracking-tight text-blue-500">
          PROYECTOS
        </h2>
        <p class="text-3xl font-medium tracking-tight text-balance text-white sm:text-4xl lg:text-5xl">
          Proyectos destacados
        </p>
      </div>

      <div class="flex w-full flex-col items-center gap-8 md:flex-row md:gap-10 lg:gap-16">
        <div class="w-full text-left md:w-1/2">
          <h3 class="pb-4 sm:pb-6 text-base sm:text-lg font-medium tracking-tight text-blue-500">
            SAAS GESTIÓN DE FLOTAS
          </h3>
          <p class="text-base sm:text-lg font-medium text-pretty text-gray-400">
            Desarrollé junto un equipo una plataforma SaaS multi-tenant para la
            gestión de flotas de vehículos. El proyecto incluye la arquitectura
            de APIs REST para el backend, desarrollo de interfaces frontend,
            despliegue mediante contenedores Docker e integración de hardware
            con dispositivos Raspberry Pi.
          </p>
        </div>
        <div class="w-full md:w-1/2">
          <video
            src="/video/Fleetly-video.mov"
            class="aspect-video w-full rounded-2xl object-cover shadow-lg"
            autoplay
            muted
            loop
            playsinline></video>
        </div>
      </div>
    </section>

    <hr class="mx-auto my-12 w-full max-w-5xl border-neutral-800 sm:my-20" />

    <!-- Sección Certificados -->
    <section
      id="certificados"
      class="mx-auto max-w-7xl px-4 py-12 sm:px-8 sm:py-16 lg:px-16"
    >
      <div class="mb-8 sm:mb-12 text-left">
        <h2 class="pb-2 sm:pb-4 text-base sm:text-lg font-medium tracking-tight text-blue-500">
          CERTIFICADOS
        </h2>
        <p class="text-3xl font-medium tracking-tight text-balance text-white sm:text-4xl lg:text-5xl">
          Certificaciones
        </p>
      </div>
    </section>

    <Footer />
  </main>
</Layout>